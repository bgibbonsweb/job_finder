# Server Configuration
NODE_ENV=production
PORT=3000

# Session Security
SESSION_SECRET=your-secret-key-here-change-in-production

# Database (PostgreSQL - required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/job_finder

# Optional: Max-volume ingestion tuning
# BUILTIN_MAX_PAGES=60
# BUILTIN_MAX_DISCOVERED_URLS=120000
# ALGOLIA_MAX_PAGES=30
# ALGOLIA_PAGE_CONCURRENCY=12
# ALGOLIA_MAX_SPLIT_DEPTH=8
# ALGOLIA_MAX_TOTAL_JOBS=180000
# ALGOLIA_CATEGORY_CONCURRENCY=3
# ALGOLIA_START_EPOCH=1672531200

# Optional: AWS S3 for archived data backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
