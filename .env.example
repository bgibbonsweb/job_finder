# Server Configuration
NODE_ENV=production
PORT=3000

# Session Security
SESSION_SECRET=your-secret-key-here-change-in-production

# Database (PostgreSQL - required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/job_finder

# Optional: USAJOBS API configuration
# USAJOBS_API_KEY=your-usajobs-api-key
# USAJOBS_MAX_PAGES=100

# Optional: Upwork API configuration (if enabled)
# UPWORK_API_KEY=your-upwork-api-key
# UPWORK_MAX_PAGES=50

# Optional: Dice job board configuration
# DICE_MAX_PAGES=50

# Optional: Max-volume ingestion tuning
# BUILTIN_MAX_PAGES=500
# BUILTIN_MAX_DISCOVERED_URLS=1500000
# BUILTIN_FETCH_CONCURRENCY=12
# ARBEITNOW_MAX_PAGES=1000
# THEMUSE_MAX_PAGES=10000
# ALGOLIA_MAX_PAGES=200
# ALGOLIA_PAGE_CONCURRENCY=24
# ALGOLIA_MAX_SPLIT_DEPTH=12
# ALGOLIA_MAX_TOTAL_JOBS=1000000
# ALGOLIA_CATEGORY_CONCURRENCY=6
# ALGOLIA_START_EPOCH=946684800

# Optional: AWS S3 for archived data backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
