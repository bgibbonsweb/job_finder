{
  "name": "job_finder",
  "version": "1.0.0",
  "description": "Basic Node.js server",
  "main": "server.js",
  "scripts": {
    "start": "npm --prefix frontend run build && node server.js",
    "dev": "node --watch server.js",
    "test": "node --test 'test/**/*.test.js'",
    "dev:frontend": "npm --prefix frontend run dev",
    "go": "concurrently --kill-others --prefix-colors cyan,green --names server,frontend \"npm run dev\" \"npm run dev:frontend\"",
    "db:init": "node server/db/init.js",
    "db:migrate": "node server/db/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
